          },
          {
            "name": "target_chain_id",
            "type": "u64"
          },
          {
            "name": "target_token",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "target_decimals",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "AddressBookRoot",
      "docs": [
        "Owner-managed source address-book namespace. The root account is initialized",
        "explicitly and then committed inside immutable `SourceHandlerData`."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "type": "pubkey"
          }
        ]
      }
    },
    {
      "name": "AddressBookRootInitialized",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "address_book_root",
            "type": "pubkey"
          },
          {
            "name": "owner",
            "type": "pubkey"
          }
        ]
      }
    },
    {
      "name": "DepositPrepared",
      "docs": [
        "Emitted by `validate_and_prepare` after funds reach adapter custody. Carries",
        "the routing inputs needed to build the target-specific bridge message."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "sra_config",
            "docs": [
              "SraConfig PDA the deposit was prepared for."
            ],
            "type": "pubkey"
          },
          {
            "name": "source_mint",
            "docs": [
              "Source mint that was locked."
            ],
            "type": "pubkey"
          },
          {
            "name": "adapter_program",
            "docs": [
              "Allowlisted adapter program for the prepared deposit."
            ],
            "type": "pubkey"
          },
          {
            "name": "nonce",
            "docs": [
              "Nonce captured before the prepare handler increments it."
            ],
            "type": "u64"
          },
          {
            "name": "input_amount",
            "docs": [
              "Tokens pulled from the owner ATA into the SRA vault and forwarded",
              "to adapter custody in the same transaction."
            ],
            "type": "u64"
          },
          {
            "name": "output_amount",
            "docs": [
              "Minimum output amount the destination must honor; enforced here via",
              "the slippage check and re-honored by the target-specific adapter flow."
            ],
            "type": "u64"
          },
          {
            "name": "target_chain_id",
            "docs": [
              "Runtime target chain id from `PrepareParams`."
            ],
            "type": "u64"
          },
          {
            "name": "target_handler",
            "docs": [
              "Opaque 32-byte target handler identifier. EVM handlers are left-padded",
              "addresses; non-EVM targets may use all 32 bytes."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "target_adapter",
            "docs": [
              "Opaque 32-byte target adapter identifier. EVM adapters are left-padded",
              "addresses; non-EVM targets may use all 32 bytes."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "recipient",
            "docs": [
              "Destination account / recipient identifier."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "app_id",
            "docs": [
              "Runtime app identifier from `PrepareParams`."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "target_token",
            "docs": [
              "Per-deposit target token identifier. Stored as raw bytes32 so Solana",
              "pubkeys and other non-EVM ids are not truncated."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "action_idxs",
            "docs": [
              "Action indices selected for the destination execution."
            ],
            "type": {
              "vec": "u64"
            }
          }
        ]
      }
    },
    {
      "name": "MintNonce",
      "docs": [
        "Persistent nonce per `(sra_config, source_mint)`. The owner-signed deposit",
        "flow will create it lazily and increment it per source-mint deposit.",
        "PDA seeds: [\"mint_nonce\", sra_config, source_mint]"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "nonce",
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "PrepareParams",
      "docs": [
        "Per-deposit inputs. Routing is NOT here: it lives in the authenticated",
        "`SourceHandlerData` (committed into the SRA identity), so a deposit cannot",
        "redirect funds. Only the amounts and action selection vary per deposit."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "input_amount",
            "type": "u64"
          },
          {
            "name": "output_amount",
            "type": "u64"
          },
          {
            "name": "action_idxs",
            "type": {
              "vec": "u64"
            }
          }
        ]
      }
    },
    {
      "name": "SourceHandlerData",
      "docs": [
        "Owner-installed source policy. Committed at SRA install via",
        "`handler_data_hash` (folded into the SRA's PDA identity) and re-supplied,",
        "then re-authenticated, on every deposit. The routing tuple",
        "(`target_chain_id` / `target_handler` / `target_adapter` / `recipient` /",
        "`app_id` / `target_token`) is part of the immutable identity, mirroring the",
        "EVM `RouteConfig` that `trigger()` reads from storage and a caller cannot",
        "redirect (see `sra-stx/src/handler/SRAHandler.sol`). Every deposit must echo",
        "this exact routing in `PrepareParams`; `validate_and_prepare` rejects any",
        "divergence. Changing the route means a new SRA at a new address — the Solana",
        "analogue of the EVM clone-proxy + `_onInstall` model."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "address_book_root",
            "type": "pubkey"
          },
          {
            "name": "target_chain_id",
            "type": "u64"
          },
          {
            "name": "target_handler",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "target_adapter",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "recipient",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "app_id",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "target_token",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "allowed_slippage_bps",
            "type": "u16"
          },
          {
            "name": "allowed_adapters",
            "type": {
              "vec": "pubkey"
            }
          }
        ]
      }
    },
    {
      "name": "SraConfig",
      "docs": [
        "One source-side SRA per `(owner, final_handler, handler_data_hash, salt)`.",
        "PDA seeds: [\"sra\", owner, config_hash, salt]",
        "config_hash = keccak256(owner ‖ final_handler ‖ handler_data_hash)"
