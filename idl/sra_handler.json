    {
      "name": "AddressBookEntry",
      "docs": [
        "Per-SRA owner-managed (chain, target_token) -> decimals registry.",
        "`target_decimals = 0` is a tombstone/disabled entry, mirroring zeroed EVM TokenInfo.",
        "PDA seeds: [\"address_book\", sra_config, chain_id.to_le_bytes(), target_token]"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "sra_config",
            "type": "pubkey"
          },
          {
            "name": "target_chain_id",
            "type": "u64"
          },
          {
            "name": "target_token",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "target_decimals",
            "docs": [
              "Decimals of `target_token` on the target chain. Serves three roles:",
              "(a) canonical record for downstream amount math, (b) EVM-parity",
              "existence sentinel, (c) tombstone marker when `0`. Tokens with 0",
              "real decimals are not representable here — not a concern for USDC",
              "and other bridgeable tokens, but worth knowing."
            ],
            "type": "u8"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "AddressBookEntrySet",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "sra_config",
            "type": "pubkey"
          },
          {
            "name": "target_chain_id",
            "type": "u64"
          },
          {
            "name": "target_token",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "target_decimals",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "DepositPrepared",
      "docs": [
        "Emitted by `validate_and_prepare` once the owner's tokens are in adapter",
        "custody. Off-chain relayers combine these raw routing fields with the",
        "immutable SraConfig to build whatever target-specific bridge message IX 2",
        "requires, whether the destination uses EVM addresses or full 32-byte IDs."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "sra_config",
            "docs": [
              "SraConfig PDA the deposit was prepared for."
            ],
            "type": "pubkey"
          },
          {
            "name": "source_mint",
            "docs": [
              "Source mint that was locked."
            ],
            "type": "pubkey"
          },
          {
            "name": "adapter_program",
            "docs": [
              "Adapter program that IX 2 will CPI into. Must be a member of",
              "`sra_config.allowed_adapters` at the time of this emission."
            ],
            "type": "pubkey"
          },
          {
            "name": "nonce",
            "docs": [
              "Pre-increment nonce captured before IX 1 bumps `mint_nonce`."
            ],
            "type": "u64"
          },
          {
            "name": "input_amount",
            "docs": [
              "Tokens pulled from the owner ATA into the SRA vault and forwarded",
              "to adapter custody in the same transaction."
            ],
            "type": "u64"
          },
          {
            "name": "output_amount",
            "docs": [
              "Minimum output amount the destination must honor; enforced here via",
              "the slippage check and re-honored by the target-specific adapter flow."
            ],
            "type": "u64"
          },
          {
            "name": "target_chain_id",
            "docs": [
              "Immutable target chain id from SraConfig, copied into the event so",
              "relayers do not need an extra account read to route the deposit."
            ],
            "type": "u64"
          },
          {
            "name": "target_handler",
            "docs": [
              "Opaque 32-byte target handler identifier. EVM handlers are left-padded",
              "addresses; non-EVM targets may use all 32 bytes."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "target_adapter",
            "docs": [
              "Opaque 32-byte target adapter identifier. EVM adapters are left-padded",
              "addresses; non-EVM targets may use all 32 bytes."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "recipient",
            "docs": [
              "Destination account / recipient identifier."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "app_id",
            "docs": [
              "App identifier copied from SraConfig."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "target_token",
            "docs": [
              "Per-deposit target token identifier. Stored as raw bytes32 so Solana",
              "pubkeys and other non-EVM ids are not truncated."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "action_idxs",
            "docs": [
              "Action indices selected for the destination execution."
            ],
            "type": {
              "vec": "u64"
            }
          }
        ]
      }
    },
    {
      "name": "MintNonce",
      "docs": [
        "Persistent nonce per `(sra_config, source_mint)`. The owner-signed deposit",
        "flow will create it lazily and increment it per source-mint deposit.",
